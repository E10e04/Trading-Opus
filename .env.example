# Trading Opus - environment configuration (example)
# Copy to backend/.env and fill in. Never commit .env.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./trading_opus.db

# BiQuote realtime feed (SignalR)
BIQUOTE_URL=https://biquote.io/hubs/tick
BIQUOTE_SYMBOLS=EURUSD,XAUUSD,BTCUSD
BIQUOTE_STALE_SECONDS=30
BIQUOTE_RECONNECT_DELAY=2
BIQUOTE_RECONNECT_MULTIPLIER=1.5

# OpenRouter (AI - key never exposed to frontend or logs)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MONTHLY_BUDGET_USD=10
OPENROUTER_TIMEOUT_S=60

# SEC EDGAR (News and Analyst agents)
SEC_USER_AGENT=

# Pelosi agent (House Clerk PTRs)
PELOSI_PDFTOTEXT_ENABLED=true
PELOSI_STATE_DIR=./state/ptr-pdfs

# Yahoo Finance (historical bars)
YAHOO_BASE_URL=https://query2.finance.yahoo.com
YAHOO_TIMEOUT_S=15

# Paper trading engine
PAPER_DEFAULT_CASH=100000.0
PAPER_COMMISSION_PCT=0.0
PAPER_SLIPPAGE_BPS=5
PAPER_MARKUP_SPREAD_PCT=0.02
